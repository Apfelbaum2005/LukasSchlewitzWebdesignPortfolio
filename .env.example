# SMTP credentials used by src/pages/api/contact.ts to send contact form
# submissions to kontakt@lukasschlewitz.de. Copy this file to `.env` and fill
# in real values - without them the contact form will show an error instead
# of sending mail. `.env` itself is gitignored and must never be committed.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for port 465 (implicit TLS), "false" for port 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# GitHub OAuth App credentials used by src/pages/oauth/* to let Decap CMS
# (see /admin) log editors in with their GitHub account. Only needed once the
# site is deployed - see the CMS setup notes for how to create the OAuth App.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
