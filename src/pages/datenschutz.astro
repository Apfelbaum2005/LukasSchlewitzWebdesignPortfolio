---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../data/consts';
import { datenschutzContent } from '../data/content';

const pageTitle = "Datenschutzerklärung";
---

<BaseLayout title={`${pageTitle} | ${SITE_TITLE}`}>
  <main class="legal-page">
    <div class="bg-glow"></div>

    <div class="container container--narrow glass-panel">
      <h1>{pageTitle}</h1>

      <section class="legal-content">
        {datenschutzContent.map((section) => (
          <div class="legal-section">
            <h2>{section.heading}</h2>
            {section.subsections.map((sub) => (
              <>
                {sub.heading && <h3>{sub.heading}</h3>}
                {sub.blocks.map((block) => (
                  block.type === 'p'
                    ? <p set:html={block.text} />
                    : <ul>{block.items.map((item) => <li set:html={item} />)}</ul>
                ))}
              </>
            ))}
          </div>
        ))}
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .legal-page {
    padding: 10rem 0 6rem;
    position: relative;
    min-height: 75vh;
    z-index: 1;
    overflow: hidden;
  }

  .legal-content :global(a) {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.3s ease;
    font-size: 0.95rem;
  }

  .legal-content :global(a:hover) {
    color: var(--accent-main);
  }

  .legal-content :global(strong) {
    color: var(--text-main);
  }

  .bg-glow {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, var(--accent-subtle) 0%, rgba(var(--bg-main-rgb), 0) 70%);
    z-index: -1;
    pointer-events: none;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
    color: var(--text-main);
  }

  h2 {
    font-size: 1.4rem;
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .legal-section:first-child h2 {
    margin-top: 0;
  }

  h3 {
    font-size: 1.05rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  p {
    color: var(--text-muted);
    line-height: 1.8;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  ul {
    color: var(--text-muted);
    line-height: 1.8;
    font-size: 0.95rem;
    margin: 0 0 1rem 1.25rem;
  }

  li {
    margin-bottom: 0.5rem;
  }

  a {
    color: var(--accent-main);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  a:hover {
    color: var(--accent-light);
  }
</style>
