---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHeader from '../components/SubpageHeader.astro';
import CardsGrid from '../components/CardsGrid.astro';
import Card from '../components/Card.astro';
import CtaSection from '../components/Start-CtaSection.astro';
import { SITE_TITLE } from '../data/consts';
import {
    leistungenHeader,
    leistungenServicesIntro,
    serviceCards,
    processTimelineHeading,
    processTimelineHighlight,
    processTimeline,
    pricingHeading,
    pricingHighlight,
    pricingPackages,
    pricingDisclaimer,
    leistungenCta
} from '../data/content';
import { Code, Search, Gauge, Server, CalendarCheck, Smartphone, Check, Info } from 'lucide-astro';

// Maps the iconName string stored in content.ts to the matching icon component
const iconMap = {
    Code, Search, Gauge, Server, CalendarCheck, Smartphone
};
---

<BaseLayout
    title={`Leistungen | ${SITE_TITLE}`}
    description={leistungenHeader.subtitle}
>
    <main>
        <SubpageHeader
            titleStart={leistungenHeader.titleStart}
            titleHighlight={leistungenHeader.titleHighlight}
            subtitle={leistungenHeader.subtitle}
            subtitleMobile={leistungenHeader.subtitleMobile}
        />

        <CardsGrid
            titleTextStart={leistungenServicesIntro.titleTextStart}
            titleTextHighlight={leistungenServicesIntro.titleTextHighlight}
            titleTextEnd={leistungenServicesIntro.titleTextEnd}
            wrap={true}
        >
            {serviceCards.map((card, index) => {
                const IconComponent = iconMap[card.iconName as keyof typeof iconMap];
                return (
                    <Card title={card.title} delayIndex={index % 3}>
                        {IconComponent && <IconComponent slot="icon" />}
                        {card.description}
                    </Card>
                )
            })}
        </CardsGrid>

        <section class="timeline-section">
            <div class="container container--medium">
                <h2 class="section-title reveal">{processTimelineHeading} <span class="text-gradient">{processTimelineHighlight}</span></h2>
                <div class="timeline">
                    {processTimeline.map((item) => (
                        <div class="timeline-item reveal">
                            <div class="timeline-dot">{item.step}</div>
                            <div class="timeline-content glass-panel">
                                <h3>{item.title}</h3>
                                <p>{item.description}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section id="pakete" class="pricing-section">
            <div class="container container--medium">
                <h2 class="section-title reveal">{pricingHeading} <span class="text-gradient">{pricingHighlight}</span></h2>

                <div class="pricing-grid">
                    {pricingPackages.map((pkg, index) => (
                        <div
                            class:list={["glass-panel", "pricing-card", "reveal", { highlighted: pkg.highlighted, "solution-style": pkg.highlighted }]}
                            style={`transition-delay: ${(index + 1) * 0.1}s;`}
                        >
                            {pkg.badge && <div class="bestseller-badge">{pkg.badge}</div>}
                            <h3>{pkg.name}</h3>
                            <div class="price">{pkg.price}</div>
                            <p class="pricing-desc">{pkg.description}</p>
                            <ul class="features">
                                {pkg.features.map((feature) => (
                                    <li><Check class="check-icon" /> {feature}</li>
                                ))}
                            </ul>
                            <a
                                href={pkg.ctaLink}
                                class:list={[pkg.highlighted ? "glow-button" : "secondary-button", "w-full", "text-center", "mt-auto"]}
                            >
                                {pkg.ctaText}
                            </a>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section class="disclaimer-section">
            <div class="container container--medium">
                <div class="glass-panel disclaimer-card reveal">
                    <div class="icon-wrapper">
                        <Info />
                    </div>
                    {pricingDisclaimer.textMobile ? (
                        <>
                            <p class="desktop-only"><strong>{pricingDisclaimer.label}</strong> {pricingDisclaimer.text}</p>
                            <p class="mobile-only"><strong>{pricingDisclaimer.label}</strong> {pricingDisclaimer.textMobile}</p>
                        </>
                    ) : (
                        <p><strong>{pricingDisclaimer.label}</strong> {pricingDisclaimer.text}</p>
                    )}
                </div>
            </div>
        </section>

        <CtaSection
            headline={leistungenCta.headline}
            description={leistungenCta.description}
            buttonText={leistungenCta.buttonText}
            buttonLink={leistungenCta.buttonLink}
        />
    </main>
</BaseLayout>

<style>
    .section-title {
        font-size: 2.25rem;
        text-align: center;
        margin-bottom: 4rem;
        font-weight: 700;
    }

    /* --- TIMELINE --- */
    .timeline-section {
        padding: 6rem 0;
        position: relative;
    }

    .timeline {
        position: relative;
        max-width: 800px;
        margin: 0 auto;
    }

    .timeline::before {
        content: '';
        position: absolute;
        top: 0;
        left: 20px;
        height: 100%;
        width: 2px;
        background: rgba(255, 255, 255, 0.1);
    }

    .timeline-item {
        position: relative;
        padding-left: 60px;
        margin-bottom: 3rem;
    }

    .timeline-item:last-child {
        margin-bottom: 0;
    }

    .timeline-dot {
        position: absolute;
        left: 0;
        top: 0;
        width: 42px;
        height: 42px;
        background: var(--bg-surface);
        border: 2px solid var(--accent-main);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: var(--accent-main);
        box-shadow: 0 0 15px var(--accent-glow);
        z-index: 2;
    }

    .timeline-content h3 {
        color: var(--text-main);
        margin-bottom: 0.5rem;
    }

    .timeline-content p {
        color: var(--text-muted);
        font-size: 0.95rem;
    }

    /* --- PRICING GRID --- */
    .pricing-section {
        padding: 6rem 0 4rem;
        background-color: rgba(0, 0, 0, 0.2);
    }

    .pricing-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        align-items: center;
    }

    .pricing-card {
        display: flex;
        flex-direction: column;
        padding: 2.5rem;
        height: 100%;
    }

    .pricing-card h3 {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .price {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--accent-main);
        margin-bottom: 1rem;
    }

    .pricing-desc {
        color: var(--text-muted);
        margin-bottom: 2rem;
        font-size: 0.9rem;
    }

    .features {
        list-style: none;
        padding: 0;
        margin-bottom: 2.5rem;
    }

    .features li {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
        color: var(--text-main);
        font-size: 0.95rem;
    }

    .check-icon {
        color: var(--accent-main);
        width: 20px;
        height: 20px;
        flex-shrink: 0;
    }

    .pricing-card.highlighted {
        transform: scale(1.05);
        border-color: rgba(59, 130, 246, 0.4);
        box-shadow: 0 15px 35px rgba(59, 130, 246, 0.15);
        position: relative;
        z-index: 2;
    }

    .pricing-card.highlighted.reveal {
        transform: translateY(30px) scale(1.05);
    }

    .pricing-card.highlighted.reveal.is-visible {
        transform: translateY(0) scale(1.05);
    }

    .bestseller-badge {
        position: absolute;
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--accent-main);
        color: white;
        padding: 0.25rem 1rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: bold;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .w-full { width: 100%; }
    .text-center { text-align: center; }
    .mt-auto { margin-top: auto; }

    /* --- PRICING DISCLAIMER --- */
    .disclaimer-section {
        padding: 2rem 0 6rem;
    }

    .disclaimer-card {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .disclaimer-card .icon-wrapper {
        flex-shrink: 0;
        color: var(--accent-main);
        background: var(--accent-subtle);
        border-radius: 12px;
        width: 3rem;
        height: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .disclaimer-card p {
        color: var(--text-muted);
        line-height: 1.7;
        font-size: 0.95rem;
        margin: 0;
    }

    .disclaimer-card p strong {
        color: var(--text-main);
    }

    @media (max-width: 768px) {
        .section-title {
            font-size: 1.75rem;
            margin-bottom: 2.5rem;
        }

        .timeline-section {
            padding: 3rem 0;
        }

        .timeline::before { left: 16px; }
        .timeline-item { padding-left: 48px; margin-bottom: 2rem; }
        .timeline-dot { width: 32px; height: 32px; font-size: 0.9rem; }

        .pricing-section {
            padding: 3rem 0 2rem;
        }

        /* Swipeable row instead of three stacked cards */
        .pricing-grid {
            display: flex;
            grid-template-columns: none;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            gap: 1rem;
            padding-bottom: 0.5rem;
            scrollbar-width: none;
        }
        .pricing-grid::-webkit-scrollbar {
            display: none;
        }
        .pricing-card {
            flex: 0 0 82%;
            min-width: 82%;
            scroll-snap-align: center;
            padding: 1.75rem;
        }

        .pricing-card.highlighted { transform: scale(1); }

        .disclaimer-section {
            padding: 1rem 0 3rem;
        }

        .disclaimer-card {
            flex-direction: column;
            text-align: center;
        }
    }
</style>