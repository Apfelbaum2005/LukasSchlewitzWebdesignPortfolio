---
export interface Props {
    aboutTagline: string;
    aboutHeadline: string;
    aboutText1: string;
    aboutText2: string;
    aboutMobileText: string;
    workTagline: string;
    workHeadline: string;
    demoProject: {
        title: string;
        description: string;
        imageAlt: string;
        buttonText: string;
        link: string;
        tags: string[];
    };
}

const {
    aboutTagline,
    aboutHeadline,
    aboutText1,
    aboutText2,
    aboutMobileText,
    workTagline,
    workHeadline,
    demoProject
} = Astro.props;

// Typewriter source (data-code) and its rendered result (data-render), read by typewriter.ts
const rawCode = `<div class="developer-profile">\n  <p>${aboutText1}</p>\n  <p>${aboutText2}</p>\n</div>`;
const renderedHTML = `<p>${aboutText1}</p><p>${aboutText2}</p>`;
---

<section class="about-work-section" id="ueber-mich">
    <div class="container container--wide">

        <div class="split-layout">

            <div class="about-content reveal">
                <span class="tagline">{aboutTagline}</span>
                <h2>{aboutHeadline}</h2> 
                
                <div class="terminal-window glass-panel js-terminal desktop-only" data-code={rawCode} data-render={renderedHTML}>
                    <div class="terminal-header">
                        <div class="mac-dots">
                            <span class="dot close"></span>
                            <span class="dot minimize"></span>
                            <a href="/ueber-mich" class="dot maximize" title="Mehr über Lukas erfahren"></a>
                        </div>
                        <span class="terminal-title">about_me.html</span>
                    </div>

                    <div class="terminal-body js-terminal-body">
                        <span class="code-font js-typewriter"></span><span class="cursor"></span>
                    </div>
                </div>

                <a href="/ueber-mich" class="mobile-about-card glass-panel mobile-only">
                    <p>{aboutMobileText}</p>
                    <span class="mobile-about-link">Mehr über mich <span aria-hidden="true">&rarr;</span></span>
                </a>
            </div>

            <div class="work-content reveal reveal-delay-1">
                <span class="tagline">{workTagline}</span>
                <h2>{workHeadline}</h2>
                
                <a href={demoProject.link} class="demo-card-wrapper">
                    <div class="demo-card">
                        <div class="demo-image-placeholder">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="placeholder-icon"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                            <span class="image-text">{demoProject.buttonText}</span>
                        </div>

                        <div class="demo-info">
                            <h3>{demoProject.title}</h3>
                            <p>{demoProject.description}</p>

                            <div class="tags">
                                {demoProject.tags.map(tag => (
                                    <span class="tag">{tag}</span>
                                ))}
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<script src="../scripts/typewriter.ts"></script>

<style>
    .about-work-section {
        padding: 8rem 0;
        position: relative;
        z-index: 1;
    }

    .split-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 4rem;
    }

    @media (min-width: 992px) {
        .split-layout {
            grid-template-columns: 1fr 1fr;
            gap: 6rem;
            align-items: stretch;
        }
    }

    .about-content, .work-content {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .terminal-window, .demo-card-wrapper {
        flex-grow: 1;
    }

    .tagline {
        display: inline-block;
        color: var(--accent-main);
        font-size: 0.875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 1.5rem;
    }

    h2 {
        font-size: 2.5rem;
        margin-bottom: 2rem;
        line-height: 1.2;
    }

    .terminal-window {
        padding: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        margin-top: 0;
    }

    .terminal-header {
        background: rgba(255, 255, 255, 0.03);
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        border-bottom: 1px solid var(--glass-border);
        position: relative;
    }

    .mac-dots {
        display: flex;
        gap: 8px;
    }

    .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: block; 
        transition: transform 0.2s ease, filter 0.2s ease;
    }

    .dot.close { background: #ff5f56; }
    .dot.minimize { background: #ffbd2e; }
    
    .dot.maximize { 
        background: #27c93f;
        cursor: pointer;
    }

    .dot.maximize:hover {
        filter: brightness(1.2);
        transform: scale(1.15);
    }

    .terminal-title {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        color: var(--text-muted);
        font-size: 0.8rem;
        font-family: monospace;
    }

    .terminal-body {
        padding: 2rem;
        transition: opacity 0.4s ease;
    }

    .code-font {
        font-family: 'Fira Code', Consolas, monospace;
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--accent-light);
        white-space: pre-wrap; 
        word-break: break-word;
    }

    .cursor {
        display: inline-block;
        width: 8px;
        height: 1.1em;
        background-color: var(--accent-main);
        vertical-align: text-bottom;
        animation: blink 1s step-end infinite;
        margin-left: 4px;
    }

    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }

    .terminal-window :global(p) {
        color: var(--text-muted);
        margin-bottom: 1.5rem;
        line-height: 1.7;
        font-size: 1.125rem;
        font-family: system-ui, -apple-system, sans-serif;
    }

    /* Simple, static replacement for the animated terminal window on small screens -
       no typewriter effect, no monospace chrome, just the text. */
    .mobile-about-card {
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s ease, border-color 0.3s ease;
    }

    .mobile-about-card:active {
        transform: scale(0.98);
    }

    .mobile-about-card p {
        color: var(--text-muted);
        line-height: 1.6;
        font-size: 0.95rem;
        margin-bottom: 1rem;
    }

    .mobile-about-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--accent-main);
        font-weight: 600;
        font-size: 0.9rem;
    }

    .demo-card-wrapper {
        display: block;
        position: relative;
        border-radius: 16px;
        padding: 2px;
        background: linear-gradient(135deg, var(--accent-glow), rgba(var(--bg-surface-rgb), 0.1), var(--accent-subtle));
        text-decoration: none;
        color: inherit;
        transition: transform 0.3s ease;
    }

    .demo-card-wrapper::before {
        content: '';
        position: absolute;
        inset: -2px;
        border-radius: 18px;
        background: var(--accent-gradient);
        filter: blur(15px);
        opacity: 0;
        z-index: -1;
        transition: opacity 0.4s ease;
    }

    .demo-card-wrapper:hover {
        transform: translateY(-5px);
    }

    .demo-card-wrapper:hover::before {
        opacity: 0.6;
    }

    .demo-card {
        background: rgba(var(--bg-surface-rgb), 0.95);
        border-radius: 14px;
        height: 100%;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        backdrop-filter: blur(10px);
    }

    .demo-image-placeholder {
        background: rgba(30, 41, 59, 0.5);
        height: 220px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .placeholder-icon {
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    .image-text {
        font-size: 0.875rem;
        font-weight: 500;
        letter-spacing: 0.05em;
    }

    .demo-info {
        padding: 2rem;
    }

    .demo-info h3 {
        font-size: 1.5rem;
        margin-bottom: 0.75rem;
        color: var(--text-main);
    }

    .demo-info p {
        color: var(--text-muted);
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag {
        background: var(--accent-subtle);
        color: var(--accent-main);
        padding: 0.25rem 0.75rem;
        border-radius: 100px;
        font-size: 0.75rem;
        font-weight: 600;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    @media (max-width: 768px) {
        /* .terminal-window already sets its own display:flex, which otherwise beats the
           global .desktop-only rule on specificity - override it here instead. */
        .terminal-window {
            display: none;
        }

        .about-work-section {
            padding: 4rem 0;
        }

        .split-layout {
            gap: 2.5rem;
        }

        h2 {
            font-size: 1.75rem;
            margin-bottom: 1.25rem;
        }

        .tagline {
            margin-bottom: 1rem;
        }

        .demo-image-placeholder {
            height: 160px;
        }

        .demo-info {
            padding: 1.5rem;
        }

        .demo-info h3 {
            font-size: 1.25rem;
        }
    }
</style>