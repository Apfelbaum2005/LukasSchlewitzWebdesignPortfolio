---
export interface Props {
    headline: string;
    description: string;
    buttonText: string;
    buttonLink: string;
}

const { 
    headline, 
    description, 
    buttonText, 
    buttonLink 
} = Astro.props;
---

<section class="cta-section">
    <div class="container container--medium">
        <div class="cta-box glass-panel">
            <div class="cta-glow"></div>
            <div class="cta-content">
                <h2>{headline}</h2>
                <p>{description}</p>
                <a href={buttonLink} class="glow-button">{buttonText}</a>
            </div>
        </div>
    </div>
</section>

<style>
    .cta-section {
        padding: 6rem 0;
        position: relative;
        z-index: 1;
    }

    .cta-box {
        position: relative;
        padding: 4rem 2rem;
        text-align: center;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid var(--accent-subtle);
    }

    .cta-glow {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(ellipse at center, var(--accent-subtle) 0%, transparent 70%);
        z-index: 0;
        pointer-events: none;
    }

    .cta-content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    h2 {
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
        line-height: 1.2;
        color: var(--text-main);
        max-width: 800px;
    }

    p {
        color: var(--text-muted);
        font-size: 1.125rem;
        line-height: 1.6;
        margin-bottom: 2.5rem;
        max-width: 600px;
    }

    @media (max-width: 768px) {
        .cta-box {
            padding: 3rem 1.5rem;
        }

        h2 {
            font-size: 2rem;
        }
    }
</style>